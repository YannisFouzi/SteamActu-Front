# Copie ce fichier vers android/keystore.properties et remplis les valeurs.
# android/keystore.properties est gitignore : ne JAMAIS le commit.
#
# Generation du keystore (a faire UNE SEULE FOIS, conserve precieusement le .jks
# et les mots de passe : un keystore perdu = impossible de mettre a jour l'app
# sur le Play Store, jamais) :
#
#   cd android
#   keytool -genkeypair -v \
#     -keystore steamnotif-release.jks \
#     -alias steamnotif \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Stocke le .jks ailleurs que dans le repo (password manager, coffre Bitwarden,
# Drive chiffre, etc.). Sauvegarde aussi storePassword + keyPassword.

storeFile=steamnotif-release.jks
storePassword=
keyAlias=steamnotif
keyPassword=
